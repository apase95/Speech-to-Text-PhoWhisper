{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run PhoWhisper Inference",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/inference.py",
            "console": "integratedTerminal",
            "args": [
                "--audio",
                "${workspaceFolder}/data/raw/test/sample.wav"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
